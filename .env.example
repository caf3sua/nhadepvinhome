# Sao chép thành .env.local và điền giá trị thật. Tất cả đều tuỳ chọn.
# Lead luôn được ghi vào .data/leads.jsonl (đổi thư mục bằng LEADS_DIR).
# Lưu ý: trên hosting serverless (Vercel…) ổ đĩa không bền, nên cấu hình
# thêm ít nhất một kênh bên dưới để không mất lead.

# Gửi thông báo lead qua Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# POST JSON lead tới webhook (Google Apps Script / Make / Zapier / n8n…)
LEAD_WEBHOOK_URL=

# Thư mục lưu file leads.jsonl (mặc định: <dự án>/.data)
LEADS_DIR=
